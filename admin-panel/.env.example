# Set these in the hosting provider's Environment Variables panel.
# NEXT_PUBLIC values are public client configuration only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_PRIVATELY_NEVER_COMMIT_THIS
ADMIN_EMAIL=YOUR_OWNER_LOGIN_EMAIL
